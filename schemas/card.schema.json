{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YGO normalized card catalog v2",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "archetypes",
          "setcodes",
          "alias",
          "type_flags",
          "level",
          "attribute",
          "race",
          "attack",
          "defense",
          "lscale",
          "rscale",
          "link_marker"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "monster",
              "spell",
              "trap"
            ]
          },
          "archetypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "setcodes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "alias": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "type_flags": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "attribute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "race": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "attack": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "defense": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "lscale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "rscale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "link_marker": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    }
  }
}