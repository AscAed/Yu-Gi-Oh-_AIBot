{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComboAnalyzeRequest",
  "type": "object",
  "required": [
    "deck",
    "opening_hand",
    "seed",
    "as_of"
  ],
  "additionalProperties": false,
  "properties": {
    "deck": {
      "type": "object",
      "required": [
        "main",
        "extra",
        "side"
      ],
      "additionalProperties": false,
      "properties": {
        "main": {
          "type": "array",
          "minItems": 40,
          "maxItems": 60,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "extra": {
          "type": "array",
          "minItems": 0,
          "maxItems": 15,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "side": {
          "type": "array",
          "minItems": 0,
          "maxItems": 15,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "opening_hand": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "rules": {
      "const": "ocg-mr5"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "catalog_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "banlist_id": {
      "type": "string"
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 5
        },
        "node_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 10000
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 32
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 64
        },
        "time_limit_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 60000
        }
      }
    }
  }
}