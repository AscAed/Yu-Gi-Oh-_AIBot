  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "check": {
      "enum": [
        "not_run",
        "passed",
        "failed"
      ]
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)[A-Za-z0-9._/-]+$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,100}$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_sha256",
        "archive_bytes",
        "file_list_sha256",
        "source_identity",
        "file_count",
        "role"
      ],
      "properties": {
        "archive_sha256": {
          "$ref": "#/$defs/hash"
        },
        "archive_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "file_list_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_identity": {
          "$ref": "#/$defs/hash"
