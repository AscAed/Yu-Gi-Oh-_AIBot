{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curry Ledger Handoff Recovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "status", "valid", "failure_checkpoint", "diagnostic",
