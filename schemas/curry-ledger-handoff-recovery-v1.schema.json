        "certified_historical_consumed_before_scope": {"type": ["integer", "null"], "minimum": 0},
        "certified_historical_consumed_including_scope": {"type": ["integer", "null"], "minimum": 0},
        "policy_reserved": {"const": 7},
        "planning_total": {"type": ["integer", "null"], "minimum": 0},
        "reservation_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "reservation_policy_id": {"const": "curry-unknown-reserve-seven-v1"},
        "old_confirmation_actual_consumed": {"type": "null"},
        "actual_all_history_cumulative": {"type": "null"}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "sha256", "bytes"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\:]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
