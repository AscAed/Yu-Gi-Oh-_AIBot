        "first_check": {"enum": ["not_run", "passed", "failed"]},
        "recheck": {"enum": ["not_run", "passed", "failed"]},
        "input_rows_revalidation": {"enum": ["not_run", "passed", "failed"]},
        "workspace": {"enum": ["not_collected", "consistent", "changed", "recheck_failed", "first_check_failed"]},
        "v5_tree": {"enum": ["not_collected", "consistent", "changed", "recheck_failed", "first_check_failed"]},
        "baseline_tree": {"enum": ["not_collected", "consistent", "changed", "recheck_failed", "first_check_failed"]},
        "reservation_tree": {"enum": ["not_collected", "consistent", "changed", "recheck_failed", "first_check_failed"]},
        "historical_trees": {"enum": ["not_collected", "consistent", "changed", "recheck_failed", "first_check_failed"]},
        "ledger_and_blobs": {"enum": ["not_collected", "consistent", "changed", "recheck_failed", "first_check_failed"]},
