    {
      "if": {"properties": {"status": {"const": "incomplete"}}},
      "then": {
        "properties": {
          "valid": {"const": false},
          "failure_checkpoint": {"type": "null"},
          "diagnostic": {"type": "null"},
          "tool": {"type": "null"},
          "checks": {"additionalProperties": {"const": "not_run"}},
          "source_groups": {"additionalProperties": {"const": 0}},
          "inputs": {"maxItems": 0},
          "accounting": {
            "properties": {
              "original_scope_consumed": {"type": "null"},
              "original_scope_completed": {"type": "null"},
              "original_scope_unknown": {"type": "null"},
              "certified_historical_consumed_before_scope": {"type": "null"},
              "certified_historical_consumed_including_scope": {"type": "null"},
              "reservation_id": {"type": "null"},
              "planning_total": {"type": "null"}
            }
          },
          "publication": {
            "properties": {
              "state": {"const": "not_run"},
              "failure_phase": {"type": "null"},
              "diagnostic_id": {"type": "null"}
            }
          }
        }
