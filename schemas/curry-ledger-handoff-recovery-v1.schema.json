      "required": ["first_check", "recheck", "input_rows_revalidation", "workspace", "v5_tree", "baseline_tree", "reservation_tree", "historical_trees", "ledger_and_blobs", "stage2_receipt_absent_before", "stage2_receipt_absent_after"],
