              "original_scope_unknown": {"type": "null"},
              "certified_historical_consumed_before_scope": {"type": "null"},
              "certified_historical_consumed_including_scope": {"type": "null"},
              "planning_total": {"type": "null"},
              "reservation_id": {"type": "null"}
            }
          }
        }
