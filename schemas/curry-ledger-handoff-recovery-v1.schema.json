  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "valid": {"const": true},
          "diagnostic": {"type": "null"},
          "tool": {"type": "object"},
          "publication": {
            "properties": {
              "state": {"const": "passed"},
              "failure_phase": {"type": "null"},
              "diagnostic_id": {"type": "null"}
