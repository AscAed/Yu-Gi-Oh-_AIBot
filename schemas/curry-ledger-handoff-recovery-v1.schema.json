          },
          "accounting": {
            "properties": {
              "certified_historical_consumed_before_scope": {"const": 32},
              "reservation_id": {"const": "09de07440402fcd12996dcbe0ed67741973b2cd095cd60b43e77b764331d3b63"}
            }
          }
        }
      }
