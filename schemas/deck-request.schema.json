{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck Optimization Request",
  "type": "object",
  "properties": {
    "archetypes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "deck": {"$ref": "#/$defs/deck"},
    "banlist_id": {"type": "string"},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 20},
    "search_budget": {"type": "integer", "minimum": 1},
    "opponent_scenarios": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "deck": {
      "type": "object",
      "properties": {
        "main": {"type": "array", "items": {"type": "integer"}},
        "extra": {"type": "array", "items": {"type": "integer"}},
        "side": {"type": "array", "items": {"type": "integer"}}
      }
    }
  }
}
