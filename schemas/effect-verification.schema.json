{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "knowledge_id": {
      "type": "string"
    },
    "sources_verified": {
      "const": true
    },
    "passed": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string"
              },
              "effect_id": {
                "type": "string"
              },
              "passed": {
                "const": true
              },
              "positive": {
                "type": "object",
                "properties": {
                  "selected": {
                    "$ref": "plan-result-v2.schema.json#/$defs/decision"
                  },
                  "before_checkpoint": {
                    "$ref": "plan-result-v2.schema.json#/$defs/prediction/properties/before_checkpoint"
                  },
                  "before_events": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "assertions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "zone": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "player": {
                          "enum": [
                            0,
                            1
                          ]
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "level": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "rank": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "overlay": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "code",
                        "zone",
                        "count"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "symbolic_prediction": {
                    "$ref": "plan-result-v2.schema.json#/$defs/step"
                  }
                },
                "required": [
                  "selected",
                  "before_checkpoint",
                  "before_events",
                  "assertions",
                  "symbolic_prediction"
                ],
                "additionalProperties": false
              },
              "negative": {
                "type": "object",
                "properties": {
                  "failure_kind": {
                    "const": "rules_rejected"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "prompt_id": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "effect_offered": {
                    "const": false
                  }
                },
                "required": [
                  "failure_kind",
                  "reason",
                  "prompt_id",
                  "effect_offered"
                ],
                "additionalProperties": false
              },
              "runtime_request": {
                "$ref": "combo-result-v3.schema.json#/properties/runtime_request"
              },
              "observation": {
                "$ref": "plan-result-v2.schema.json#/$defs/observation"
              },
              "independent_replay": {
                "const": true
              },
              "prefix_witness_verified": {
                "const": true
              },
              "engine_calls": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "case_id",
              "effect_id",
              "passed",
              "positive",
              "negative",
              "runtime_request",
              "observation",
              "independent_replay",
              "prefix_witness_verified",
              "engine_calls"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string"
              },
              "effect_id": {
                "type": "string"
              },
              "passed": {
                "const": false
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "case_id",
              "effect_id",
              "passed",
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "knowledge_id",
    "sources_verified",
    "passed",
    "cases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
