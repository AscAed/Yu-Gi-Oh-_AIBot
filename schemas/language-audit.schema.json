{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "language-audit.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "qualified",
    "qualification_gate",
    "provenance_checks_passed",
    "sources",
    "sample_card_ids",
    "missing_card_ids",
    "ambiguous_names",
    "unresolved",
    "records",
    "scope",
    "record_count"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "qualified": {
      "const": false
    },
    "qualification_gate": {
      "const": "independent_semantic_review_not_implemented"
    },
    "provenance_checks_passed": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "language",
          "version",
          "sha256",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "type": "object",
            "required": [
              "redistribution"
            ],
            "properties": {
              "redistribution": {
                "enum": [
                  "unknown",
                  "permitted",
                  "prohibited"
                ]
              }
            }
          }
        }
      }
    },
    "sample_card_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "missing_card_ids": {
      "type": "array"
    },
    "ambiguous_names": {
      "type": "array"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "language"
        ],
        "properties": {
          "card_id": {
            "type": "integer",
            "minimum": 1
          },
          "language": {
            "enum": [
              "zh-Hans",
              "zh-Hant"
            ]
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "source",
              "status"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "unverified",
                  "missing",
                  "ambiguous"
                ]
              }
            }
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "source",
              "status"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "unverified",
                  "missing",
                  "ambiguous"
                ]
              }
            }
          },
          "alias": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "source",
              "status"
            ],
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "unverified",
                  "missing",
                  "ambiguous"
                ]
              }
            }
          },
          "archetypes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "source",
              "status"
            ],
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "unverified",
                  "missing",
                  "ambiguous"
                ]
              }
            }
          }
        }
      }
    },
    "scope": {
      "const": "explicit-card-id-sample"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
