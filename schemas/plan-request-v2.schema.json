{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanRequest v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "analysis": {
      "$ref": "combo-request.schema.json"
    },
    "goal": {
      "const": "rusty-fog"
    },
    "knowledge_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^knowledge-[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_proposals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "scenario": {
      "enum": [
        null,
        "ryu-ran"
      ]
    }
  },
  "required": [
    "schema_version",
    "analysis"
  ],
  "additionalProperties": false
}
