{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled Ash recovery request v4",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 4
    },
    "analysis": {
      "allOf": [
        {
          "$ref": "combo-request.schema.json"
        },
        {
          "properties": {
            "search": {
              "properties": {
                "node_budget": {
                  "maximum": 512
                }
              }
            }
          }
        }
      ]
    },
    "goal": {
      "$ref": "goal.schema.json"
    },
    "knowledge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_proposals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "max_steps": {
      "type": "integer",
      "minimum": 4,
      "maximum": 32
    },
    "interruption": {
      "type": "object",
      "properties": {
        "opponent_deck": {
          "type": "object",
          "required": [
            "main",
            "extra",
            "side"
          ],
          "additionalProperties": false,
          "properties": {
            "main": {
              "type": "array",
              "minItems": 40,
              "maxItems": 60,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "extra": {
              "type": "array",
              "minItems": 0,
              "maxItems": 15,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "side": {
              "type": "array",
              "minItems": 0,
              "maxItems": 15,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            }
          }
        },
        "opponent_hand": {
          "const": [
            14558127
          ]
        },
        "policy": {
          "const": "ash_scales_once"
        },
        "effect_id": {
          "const": "25538345:mill"
        },
        "occurrence": {
          "const": 1
        }
      },
      "required": [
        "opponent_deck",
        "opponent_hand",
        "policy",
        "effect_id",
        "occurrence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "analysis",
    "goal",
    "knowledge_id",
    "max_steps",
    "max_proposals",
    "interruption"
  ],
  "additionalProperties": false
}
