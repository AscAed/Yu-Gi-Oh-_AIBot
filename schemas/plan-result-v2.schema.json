{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanReport v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^knowledge-[a-f0-9]{64}$"
    },
    "knowledge": {
      "$ref": "knowledge-v2.schema.json"
    },
    "request": {
      "$ref": "plan-request-v2.schema.json"
    },
    "proposals": {
      "$ref": "#/$defs/proposals"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      },
      "maxItems": 8
    },
    "analysis": {
      "$ref": "combo-result-v3.schema.json"
    },
    "failure_summary": {
      "type": "array",
      "items": {
        "enum": [
          "rules_rejected",
          "coverage_gap",
          "prediction_mismatch",
          "prompt_unbound",
          "budget_exhausted",
          "engine_failure",
          "no_plan_found"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "knowledge_id",
    "knowledge",
    "request",
    "proposals",
    "attempts",
    "analysis",
    "failure_summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string"
        },
        "code": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "redirect": {
          "type": "boolean"
        },
        "player": {
          "enum": [
            0,
            1
          ]
        },
        "overlay_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "xyz_summoned": {
          "type": "boolean"
        },
        "base_level": {
          "type": "integer",
          "minimum": 0
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "instance",
        "code",
        "location",
        "level",
        "redirect",
        "player",
        "overlay_host",
        "xyz_summoned",
        "base_level",
        "epoch"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "used": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "normal_left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "dark_only": {
          "type": "boolean"
        },
        "destroyed_xyz": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "cards",
        "used",
        "normal_left",
        "pending",
        "dark_only",
        "destroyed_xyz"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "normal_summon",
            "special_summon",
            "activate",
            "trigger",
            "link_summon",
            "set",
            "end_turn",
            "xyz_summon"
          ]
        },
        "effect_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/resource"
        },
        "costs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "kind",
        "effect_id",
        "source",
        "costs",
        "targets",
        "reason",
        "after"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "goal_predicted": {
          "const": true
        }
      },
      "required": [
        "id",
        "steps",
        "goal_predicted"
      ],
      "additionalProperties": false
    },
    "proposals": {
      "type": "object",
      "properties": {
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal"
          },
          "maxItems": 8
        },
        "expansions": {
          "type": "integer",
          "minimum": 0
        },
        "termination": {
          "type": "string"
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "plans",
        "expansions",
        "termination",
        "coverage_gaps"
      ],
      "additionalProperties": false
    },
    "card_reference": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0
        },
        "player": {
          "enum": [
            0,
            1
          ]
        },
        "location": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "player",
        "location",
        "sequence",
        "position"
      ],
      "additionalProperties": false
    },
    "choice": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "command"
            },
            "command": {
              "type": "integer",
              "minimum": 0
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "command",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cards"
            },
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "kind",
            "indices"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "toggle"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "finish"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "yes_no"
            },
            "yes": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "yes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "option"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "place"
            },
            "zones": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "player": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "location": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "player",
                  "location",
                  "sequence"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "zones"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "position"
            },
            "position": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "position"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "chain"
            },
            "index": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "decision": {
      "type": "object",
      "properties": {
        "prompt_id": {
          "type": "integer",
          "minimum": 1
        },
        "player": {
          "enum": [
            0,
            1
          ]
        },
        "choice": {
          "$ref": "#/$defs/choice"
        }
      },
      "required": [
        "prompt_id",
        "player",
        "choice"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "choice": {
          "$ref": "#/$defs/choice"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/card_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_description": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card_reference"
          }
        },
        "selection_group": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "choice",
        "source",
        "effect_description",
        "selected",
        "selection_group"
      ],
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "properties": {
        "semantic_step": {
          "type": "integer",
          "minimum": 0
        },
        "effect_id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "before_prefix": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "before_events": {
          "type": "integer",
          "minimum": 0
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata"
          },
          "minItems": 1
        },
        "selected": {
          "$ref": "#/$defs/decision"
        },
        "after_events": {
          "type": "integer",
          "minimum": 0
        },
        "before_checkpoint": {
          "type": "object",
          "properties": {
            "turn": {
              "type": "integer",
              "minimum": 0
            },
            "turn_player": {
              "enum": [
                0,
                1
              ]
            },
            "phase": {
              "type": "integer",
              "minimum": 0
            },
            "lp": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "location": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "type_flags": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "player": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "attack": {
                    "type": "integer"
                  },
                  "defense": {
                    "type": "integer"
                  },
                  "overlay": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "required": [
                  "code",
                  "location",
                  "sequence",
                  "position",
                  "type_flags",
                  "level",
                  "rank",
                  "player",
                  "attack",
                  "defense",
                  "overlay"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "turn",
            "turn_player",
            "phase",
            "lp",
            "cards"
          ],
          "additionalProperties": false
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison"
          },
          "minItems": 1
        },
        "outcome": {
          "enum": [
            "observed",
            "unobserved"
          ]
        }
      },
      "required": [
        "semantic_step",
        "effect_id",
        "reason",
        "before_prefix",
        "before_events",
        "alternatives",
        "selected",
        "after_events",
        "before_checkpoint",
        "comparisons",
        "outcome"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 3
        },
        "status": {
          "enum": [
            "engine_verified",
            "decision_required",
            "partial",
            "failed",
            "probe_passed"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "opcode": {
                "type": "integer",
                "minimum": 0
              },
              "raw": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "supported": {
                "type": "boolean"
              },
              "fields": {
                "type": "object"
              }
            },
            "required": [
              "sequence",
              "opcode",
              "raw",
              "supported",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "prompt": {
          "type": [
            "object",
            "null"
          ]
        },
        "checkpoint": {
          "type": "object",
          "properties": {
            "turn": {
              "type": "integer",
              "minimum": 0
            },
            "turn_player": {
              "enum": [
                0,
                1
              ]
            },
            "phase": {
              "type": "integer",
              "minimum": 0
            },
            "lp": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "location": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "type_flags": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "player": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "attack": {
                    "type": "integer"
                  },
                  "defense": {
                    "type": "integer"
                  },
                  "overlay": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "required": [
                  "code",
                  "location",
                  "sequence",
                  "position",
                  "type_flags",
                  "level",
                  "rank",
                  "player",
                  "attack",
                  "defense",
                  "overlay"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "turn",
            "turn_player",
            "phase",
            "lp",
            "cards"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": [
            "object",
            "null"
          ]
        },
        "versions": {
          "type": "object"
        },
        "loaded_scripts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "resolved_decisions": {
          "type": "array",
          "items": {
            "$ref": "plan-result-v2.schema.json#/$defs/decision"
          }
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "peak_working_set_bytes": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "protocol_version",
        "status",
        "events",
        "prompt",
        "checkpoint",
        "error",
        "versions",
        "loaded_scripts",
        "steps",
        "resolved_decisions",
        "coverage_gaps",
        "peak_working_set_bytes"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "unverified",
            "engine_verified",
            "prediction_rejected"
          ]
        },
        "goal_achieved": {
          "type": "boolean"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "predictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prediction"
          }
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grave_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "rules_rejected",
                "coverage_gap",
                "prediction_mismatch",
                "prompt_unbound",
                "budget_exhausted",
                "engine_failure",
                "no_plan_found"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "proposal_id",
        "status",
        "goal_achieved",
        "line_id",
        "predictions",
        "discrepancies",
        "grave_resources",
        "observation",
        "failure"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "choice",
        "selected",
        "reasons",
        "consumer_effects"
      ],
      "properties": {
        "choice": {
          "$ref": "#/$defs/choice"
        },
        "selected": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "consumer_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
