{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygo.local/schemas/prompt-corpus-audit.schema.json",
  "title": "Read-only historical prompt corpus audit v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "provenance", "sources", "summary", "successful", "observed_opcodes", "unobserved_opcodes", "native_calls", "complete_action_coverage", "global_optimality", "coverage_gaps"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "prompt_corpus_audit"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_head", "source_identity", "runner_sha256"],
      "properties": {"source_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "source_identity": {"$ref": "#/$defs/hash"}, "runner_sha256": {"$ref": "#/$defs/hash"}}
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["frames", "current_mismatches", "historical_mismatches", "errors", "historical_unavailable"],
      "properties": {"frames": {"type": "integer", "minimum": 1}, "current_mismatches": {"$ref": "#/$defs/count"}, "historical_mismatches": {"$ref": "#/$defs/count"}, "errors": {"$ref": "#/$defs/count"}, "historical_unavailable": {"$ref": "#/$defs/count"}}
    },
    "successful": {"type": "boolean"},
    "observed_opcodes": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "unobserved_opcodes": {"type": "array", "uniqueItems": true, "items": {"enum": [11,12,13,14,15,16,18,19,24,26]}},
    "native_calls": {"const": 0}, "complete_action_coverage": {"const": false}, "global_optimality": {"const": false},
    "coverage_gaps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "audit", "diagnostic"],
      "properties": {"status": {"enum": ["matched", "mismatch", "error", "unavailable"]}, "audit": {"anyOf": [{"$ref": "response-audit.schema.json"}, {"type": "null"}]}, "diagnostic": {"type": ["string", "null"]}},
      "oneOf": [
        {"properties": {"status": {"enum": ["matched", "mismatch"]}, "audit": {"type": "object"}, "diagnostic": {"type": "null"}}},
        {"properties": {"status": {"enum": ["error", "unavailable"]}, "audit": {"type": "null"}, "diagnostic": {"type": "string", "minLength": 1}}}
      ]
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "opcode", "raw_sha256", "current", "historical"],
      "properties": {"sequence": {"$ref": "#/$defs/count"}, "opcode": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "null"}]}, "raw_sha256": {"$ref": "#/$defs/hash"}, "current": {"allOf": [{"$ref": "#/$defs/comparison"}, {"properties": {"status": {"enum": ["matched", "mismatch", "error"]}}}]}, "historical": {"$ref": "#/$defs/comparison"}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "sha256", "request_sha256", "origin", "frames"],
      "properties": {"role": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "sha256": {"$ref": "#/$defs/hash"}, "request_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "origin": {"enum": ["historical_report", "synthetic_fixture"]}, "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}}}
    }
  }
}
