{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-evidence.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "card_id",
          "status"
        ],
        "properties": {
          "card_id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "released",
              "prerelease",
              "unknown"
            ]
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "released_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "sha256"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
