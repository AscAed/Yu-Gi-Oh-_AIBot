{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygo.local/schemas/research-case.schema.json",
  "title": "Frozen research case v1; structural validation is not proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "purpose", "rules", "assets", "deck", "opening_hand", "seed", "objective", "information", "randomness"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "purpose": {"enum": ["protocol_audit", "proof_input"]},
    "seed": {"type": "integer", "minimum": 0},
    "rules": {
      "type": "object", "additionalProperties": false,
      "required": ["region", "version", "banlist_sha256"],
      "properties": {"region": {"const": "OCG"}, "version": {"type": "string", "minLength": 1}, "banlist_sha256": {"$ref": "#/$defs/hash"}}
    },
    "assets": {
      "type": "object", "additionalProperties": false,
      "required": ["engine_sha256", "cdb_sha256", "scripts_sha256"],
      "properties": {"engine_sha256": {"$ref": "#/$defs/hash"}, "cdb_sha256": {"$ref": "#/$defs/hash"}, "scripts_sha256": {"$ref": "#/$defs/hash"}}
    },
    "deck": {
      "type": "object", "additionalProperties": false, "required": ["main", "extra", "side"],
      "properties": {
        "main": {"allOf": [{"$ref": "#/$defs/cards"}, {"minItems": 40, "maxItems": 60}]},
        "extra": {"allOf": [{"$ref": "#/$defs/cards"}, {"maxItems": 15}]},
        "side": {"allOf": [{"$ref": "#/$defs/cards"}, {"maxItems": 15}]}
      }
    },
    "opening_hand": {"allOf": [{"$ref": "#/$defs/cards"}, {"minItems": 5, "maxItems": 5}]},
    "objective": {
      "type": "object", "additionalProperties": false, "required": ["priorities", "terminal_utility"],
      "properties": {
        "priorities": {"const": ["terminal_utility"]},
        "terminal_utility": {
          "type": "object", "additionalProperties": false, "required": ["normal", "early_win", "loss", "draw"],
          "properties": {"normal": {"type": "integer"}, "early_win": {"type": "integer"}, "loss": {"type": "integer"}, "draw": {"type": "integer"}}
        }
      }
    },
    "information": {
      "type": "object", "additionalProperties": false,
      "required": ["player_visible", "opponent_visible", "hidden", "opponent_resources"],
      "properties": {
        "player_visible": {"$ref": "#/$defs/observations"},
        "opponent_visible": {"$ref": "#/$defs/observations"},
        "hidden": {"$ref": "#/$defs/observations"},
        "opponent_resources": {
          "type": "object", "additionalProperties": false, "required": ["main", "hand"],
          "properties": {"main": {"allOf": [{"$ref": "#/$defs/cards"}, {"minItems": 40, "maxItems": 60}]}, "hand": {"allOf": [{"$ref": "#/$defs/cards"}, {"maxItems": 5}]}}
        }
      }
    },
    "randomness": {
      "type": "object", "additionalProperties": false, "required": ["model", "outcomes", "seed_role"],
      "properties": {
        "model": {"enum": ["frozen_scenario", "explicit_distribution"]},
        "seed_role": {"const": "reproduction_only"},
        "outcomes": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["id", "numerator", "denominator"], "properties": {"id": {"type": "string", "minLength": 1}, "numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cards": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 4294967295}},
    "observations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["own_hand", "opponent_hand", "own_deck_order", "opponent_deck_order", "public_board", "public_history"]}}
  }
}
