{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygo.local/schemas/snapshot-evaluation-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "snapshot_evaluation"
    },
    "objective": {
      "const": "rabbit-own-face-up-xyz-v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "enum": [
            "synthetic_fixture",
            "historical_report"
          ]
        }
      },
      "required": [
        "sha256",
        "request_sha256",
        "origin"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cdb_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_head",
        "source_identity",
        "runner_sha256",
        "cdb_sha256"
      ]
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_index": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "execution",
              "replay",
              "additional_record"
            ]
          },
          "snapshot_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 7
          },
          "termination": {
            "enum": [
              "execution_failed",
              "unknown",
              "natural_end",
              "next_turn_boundary_observed",
              "not_terminated",
              "terminal_boundary_bound"
            ]
          },
          "utility": {
            "enum": [
              null,
              -2,
              -1,
              0,
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "binding_valid": {
            "type": "boolean"
          }
        },
        "required": [
          "run_index",
          "role",
          "snapshot_count",
          "termination",
          "utility",
          "diagnostics",
          "binding_valid"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                }
              }
            },
            "then": {
              "properties": {
                "binding_valid": {
                  "const": true
                },
                "snapshot_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                },
                "utility": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                }
              }
            },
            "else": {
              "properties": {
                "binding_valid": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "not": {
                    "enum": [
                      "terminal_boundary_bound",
                      "natural_end"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "natural_end"
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "enum": [
                    null,
                    -2,
                    -1,
                    8
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 0
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 1
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 2
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 3
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 3
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 4
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 4
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 5
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 5
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 6
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 6
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "termination": {
                  "const": "terminal_boundary_bound"
                },
                "snapshot_count": {
                  "const": 7
                }
              }
            },
            "then": {
              "properties": {
                "utility": {
                  "const": 7
                }
              }
            }
          }
        ]
      }
    },
    "native_calls": {
      "const": 0
    },
    "source_authenticity_verified": {
      "const": false
    },
    "native_replay_verified": {
      "const": false
    },
    "proof_ready": {
      "const": false
    },
    "complete_action_coverage": {
      "const": false
    },
    "global_optimality": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "objective",
    "source",
    "provenance",
    "evaluations",
    "native_calls",
    "source_authenticity_verified",
    "native_replay_verified",
    "proof_ready",
    "complete_action_coverage",
    "global_optimality"
  ]
}
